# Copia in .env (cp .env.example .env · su Windows: Copy-Item .env.example .env)
# e poi docker compose up -d per applicare.

# interfaccia su cui pubblicare le porte: 0.0.0.0 per mostrare la demo ad altri in rete
# (la dashboard non ha autenticazione e Mosquitto accetta connessioni anonime)
BIND_ADDR=127.0.0.1
# porta della dashboard sull'host
DASHBOARD_PORT=8080
# compressione temporale: 1 s reale = N s simulati
IOTSIM_FATTORE=20
# seme dei generatori casuali (stesso seme = stessa simulazione)
IOTSIM_SEME=42
# ore di storico generate all'avvio per le 3 stazioni demo
IOTSIM_STORICO_H=24
# 1 = nessuna stazione demo all'avvio
IOTSIM_VUOTO=0
# stazioni di prova da registrare all'avvio (100 = scenario nominale S1)
IOTSIM_CREA_STAZIONI=0

# servizi facoltativi: togli il commento per avviare anche Mosquitto e "traffico" con il solo up --build
#COMPOSE_PROFILES=mqtt
# porta di Mosquitto sull'host (solo profilo mqtt)
MQTT_PORT=1883
